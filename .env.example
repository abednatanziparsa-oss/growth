# =============================================================================
# Growth OS — environment variables template
# =============================================================================
# Copy this file to .env and fill in values as needed.
#
#   cp .env.example .env
#
# NEVER commit the real .env file. It is already in .gitignore.
# These are also respected as plain environment variables without .env.
# =============================================================================

# --- Application ------------------------------------------------------------
# Environment tier: development | testing | production
# Controls logging verbosity, config validation strictness, etc.
GROWTH_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
GROWTH_LOG_LEVEL=INFO

# Optional: log file path. If unset, only console logging is active.
# GROWTH_LOG_FILE=

# Data directory for local storage (SQLite, sync state, etc.).
# Default: ~/.growth
# GROWTH_DATA_DIR=

# --- AI (all optional, all off by default) ---------------------------------
# Set to "true" to enable any AI features. When false (default), all AI ports
# use Noop implementations — no model calls, no network, no cost.
GROWTH_AI_ENABLED=false

# --- Provider: Todoist (optional, needed at sync time) ----------------------
# TODOIST_API_TOKEN=

# --- Provider: Google Calendar (future) ------------------------------------
# GOOGLE_CALENDAR_CREDENTIALS_FILE=
