# =============================================================================
# Growth OS — environment variables template
# =============================================================================
# Copy this file to .env and fill in values as needed.
#
#   cp .env.example .env     (Linux / macOS)
#   copy .env.example .env   (Windows)
#
# NEVER commit the real .env file. It is already in .gitignore.
# These are also respected as plain environment variables without .env.
#
# Load order (later overrides earlier):
#   1. Code defaults
#   2. .env file
#   3. Process environment variables (GROWTH_*)
# =============================================================================

# --- Core -------------------------------------------------------------------
# Environment tier: development | testing | production
# Controls logging verbosity, config validation strictness, etc.
GROWTH_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
GROWTH_LOG_LEVEL=INFO

# Optional: log file path. If unset, only console logging is active.
# GROWTH_LOG_FILE=

# Data directory for local storage (SQLite, sync state, etc.).
# Default: ~/.growth
# GROWTH_DATA_DIR=

# --- Provider: Todoist (required for v0.2 sync) ----------------------------
# Get your token from: https://todoist.com/app/settings/integrations
# GROWTH_TODOIST_API_TOKEN=

# --- AI (all optional, all off by default) ---------------------------------
# Set to "true" to enable any AI features. When false (default), all AI ports
# use Noop implementations — no model calls, no network, no cost.
GROWTH_AI_ENABLED=false

# --- Embeddings: local Ollama (optional, offline alternative) ---------------
# When set, semantic search uses the Ollama embedder (falls back to the
# local n-gram embedder when the server is unreachable).
# GROWTH_OLLAMA_BASE_URL=http://127.0.0.1:11434
# GROWTH_OLLAMA_MODEL=bge-m3

# --- LLM chat: OpenAI-compatible endpoint (GitHub Models / OpenRouter) ------
# Wired only when GROWTH_AI_ENABLED=true AND base_url AND api_key are set.
# GitHub Models (free, no card): base https://models.github.ai/inference,
# api key = a GitHub PAT (repo read scope is enough).
# GROWTH_LLM_BASE_URL=https://models.github.ai/inference
# GROWTH_LLM_MODEL=gpt-4o-mini
# GROWTH_LLM_API_KEY=
# GROWTH_LLM_TIMEOUT=60

# --- Google Calendar (v0.5) --------------------------------------------------
# Desktop OAuth client: credentials.json + token.json (via `growth calendar auth`).
# GROWTH_GOOGLE_CREDENTIALS_PATH=
# GROWTH_GOOGLE_TOKEN_PATH=

# --- Provider: Todoist (required for v0.2 sync) ----------------------------
# Get your token from: https://todoist.com/app/settings/integrations
# GROWTH_TODOIST_API_TOKEN=
