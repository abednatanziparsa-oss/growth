# =============================================================================
# Growth OS — gitignore
# =============================================================================

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
eggs/
sdist/

# --- Virtual environments & package managers -------------------------------
.venv/
venv/
env/
.python-version

# --- Testing & coverage ----------------------------------------------------
htmlcov/
.coverage
coverage.xml
*.cover
.pytest_cache/

# --- Type checking & linting -----------------------------------------------
.mypy_cache/
.ruff_cache/

# --- Environment / secrets (NEVER commit real .env) ------------------------
.env
.env.local
.env.production

# --- Operating system -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / editor -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.code-workspace

# --- Output artifacts -------------------------------------------------------
*.log
*.csv

# --- Aider ------------------------------------------------------------------
.aider*

# --- ZCode (tool-local) ----------------------------------------------------
.zcode/

# --- Agent runtime files (autoclaw/hermes) ---------------------------------
