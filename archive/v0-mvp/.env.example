# Growth - Placement Exam
# Copy this file to ".env" and fill in your Todoist API token.
#
# How to get your token:
#   1. Log in to https://todoist.com
#   2. Open Settings -> Integrations -> Developer
#   3. Copy your personal API token
#
# IMPORTANT: Never commit the real .env file. It is already in .gitignore.

TODOIST_API_TOKEN=your_todoist_api_token_here
